# Project-wide ESP-IDF defaults. PlatformIO generates sdkconfig.<env> from this file.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# New firmware from an over-the-air update must mark itself valid, or the
# bootloader returns to the previous version on the next restart.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LVGL: render in 8-bit greyscale; display_manager converts to 1-bit for the panel.
CONFIG_LV_COLOR_DEPTH_8=y
# Use the system heap so decoded PNGs aren't limited by LVGL's own memory pool.
CONFIG_LV_USE_CLIB_MALLOC=y
# PNG decoder for images embedded from src/assets/.
CONFIG_LV_USE_LODEPNG=y
# Built-in fonts (compiled in as bitmap arrays). Enable more sizes as needed.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# LVGL rendering and PNG decoding run in app_main and need more than the
# default ~4KB main task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Faster Wi-Fi reconnects: ask the router for the last IP address instead of
# negotiating a new one, and don't wait to check the address is unused.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
